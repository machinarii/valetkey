#!/usr/bin/env python3
"""relay: ask the credential relay about names and request new ones (no values ever pass through here)."""
import argparse
import json
import os
from pathlib import Path
from http.client import HTTPException
import re
import socket
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

def _config_file():
    return os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                        "valetkey", "relay-url")


def _relay_url():
    """Broker URL: $RELAY_URL, else the first line of ~/.config/valetkey/relay-url (written by
    `install.sh client --relay-url ...`). Empty if neither is set."""
    url = os.environ.get("RELAY_URL", "").strip()
    if not url:
        try:
            with open(_config_file(), encoding="utf-8") as f:
                url = f.readline().strip()
        except OSError:
            url = ""
    return url.rstrip("/")


# Keep the version in the executable so copied clients and Homebrew symlinks identify themselves.
# The install test checks it against the repository VERSION.
CLIENT_VERSION = "0.2.2"
TAGS_URL = "https://api.github.com/repos/machinarii/valetkey/tags"
STABLE_TAG = re.compile(r"v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)")
BASE = ""
NO_URL = ("no broker URL: set RELAY_URL=https://broker.<tailnet>.ts.net or run "
          "`relay set-url https://broker.<tailnet>.ts.net`")


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """A redirect is an error (HTTPError with the 3xx code), never followed."""

    def redirect_request(self, *a, **kw):
        return None


# No proxies from the environment and no redirects: tailnet traffic goes straight to the broker.
OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())


RETRY_DELAY = 0.3
TRANSIENT = (urllib.error.URLError, ConnectionError, socket.timeout, TimeoutError)


def call(method, path, body=None, retry=False):
    """(status, text). Network failures exit 1 with a one-line reason; bodies are only returned, never printed here.

    retry (idempotent GETs only): one more attempt after 0.3 s on a connection error or timeout,
    never after an HTTP status.
    """
    if not good_addr(BASE):
        sys.exit("relay: bad RELAY_URL (https:// required; HTTP allowed only on loopback for tests)")
    data = json.dumps(body).encode() if body is not None else None
    for attempt in (1, 2):
        req = urllib.request.Request(BASE + path, data=data, method=method)
        if data is not None:
            req.add_header("Content-Type", "application/json")
        try:
            with OPENER.open(req, timeout=15) as r:
                return r.status, r.read().decode("utf-8", "replace")
        except urllib.error.HTTPError as e:
            return e.code, e.read().decode("utf-8", "replace")
        except TRANSIENT as e:
            if retry and attempt == 1:
                time.sleep(RETRY_DELAY)
                continue
            sys.exit(f"relay: cannot reach broker ({type(getattr(e, 'reason', e)).__name__})")
        except Exception as e:
            sys.exit(f"relay: cannot reach broker ({type(getattr(e, 'reason', e)).__name__})")


def one_line(text):
    return (text.strip().splitlines() or [""])[0][:200]


def good_addr(addr):
    if any(c.isspace() or ord(c) < 32 for c in addr):
        return False
    try:
        u = urllib.parse.urlsplit(addr)
        u.port
        return bool(u.hostname and u.username is None and not u.query and not u.fragment
                    and (u.scheme == "https" or (u.scheme == "http" and u.hostname in ("127.0.0.1", "localhost"))))
    except ValueError:
        return False


def cmd_version(a):
    print(CLIENT_VERSION)


def cmd_latest_version(a):
    latest = None
    page = 1
    while True:
        try:
            with OPENER.open(f"{TAGS_URL}?per_page=100&page={page}", timeout=10) as response:
                data = response.read(1024 * 1024 + 1)
            if len(data) > 1024 * 1024:
                raise ValueError
            tags = json.loads(data)
            if not isinstance(tags, list):
                raise ValueError
            for tag in tags:
                if not isinstance(tag, dict) or not isinstance(tag.get("name"), str):
                    raise ValueError
                match = STABLE_TAG.fullmatch(tag["name"])
                if match:
                    version = tuple(map(int, match.groups()))
                    if latest is None or version > latest:
                        latest = version
        except urllib.error.HTTPError as error:
            sys.exit(f"relay: GitHub tag lookup failed (HTTP {error.code})")
        except (OSError, HTTPException):
            sys.exit("relay: could not reach GitHub to check the latest version")
        except (ValueError, RecursionError):
            sys.exit("relay: invalid tag list from GitHub")
        if len(tags) < 100:
            break
        page += 1
    if latest is None:
        sys.exit("relay: no stable Valetkey version tag found")
    print(".".join(map(str, latest)))


GUIDE_TOPICS = {
    "claude": "## Claude Code subscription sign-in",
    "claude-mem": "## Optional claude-mem integration",
    "models": "## API-billed model access",
}


def cmd_guide(a):
    """Offline instructions: no network, vault access, or credential inspection."""
    root = Path(__file__).resolve().parent.parent
    for path in (root / "agents/credential-rules.md", root / "share/valetkey/credential-rules.md"):
        if path.is_file():
            rules = path.read_text(encoding="utf-8")
            if a.topic:
                heading = GUIDE_TOPICS[a.topic]
                section = rules.partition(heading + "\n")
                if not section[1]:
                    sys.exit(f"relay: {a.topic} guidance missing; update the installed client guidance")
                rules = heading + "\n" + section[2].split("\n## ", 1)[0].rstrip() + "\n"
            print(rules, end="")
            return 0
    sys.exit("relay: guidance missing; reinstall the client or read agents/credential-rules.md")


def cmd_set_url(a):
    """Save the broker URL for relay and vault-entry (what `install.sh client --relay-url` does)."""
    url = a.url.strip().rstrip("/")
    if not (good_addr(url) and urllib.parse.urlsplit(url).scheme == "https"
            and urllib.parse.urlsplit(url).path == ""):
        sys.exit("relay: the broker URL must be https://<host> with no path, e.g. https://broker.<tailnet>.ts.net")
    cfg = _config_file()
    os.makedirs(os.path.dirname(cfg), exist_ok=True)
    with open(cfg, "w", encoding="utf-8") as f:
        f.write(url + "\n")
    print(f"ok    broker URL {url} saved in {cfg}")
    return 0


def cmd_check(a):
    status, text = call("GET", f"/{a.org}/check?names=" + ",".join(urllib.parse.quote(n, safe="") for n in a.names),
                          retry=True)
    if status != 200:
        sys.exit(f"relay: check failed ({status})")
    try:
        res = json.loads(text)
    except ValueError:
        sys.exit("relay: check failed (bad response)")
    if not isinstance(res, dict) or any(v not in ("ok", "missing", "not-allowed") for v in res.values()):
        sys.exit("relay: check failed (bad response)")
    bad = False
    for n in a.names:
        st = res.get(n, "missing")
        print(f"{st}  {n}")
        bad = bad or st != "ok"
    return 1 if bad else 0


def cmd_backups(a):
    """Dates of <name>'s backups, newest first; each is read like the item, as <name>-backup-<date>."""
    status, text = call("GET", f"/{a.org}/backups/{urllib.parse.quote(a.name, safe='')}", retry=True)
    if status in (403, 404):
        sys.exit(f"relay: {one_line(text)} ({status})")
    if status != 200:
        sys.exit(f"relay: backups failed ({status})")
    try:
        dates = json.loads(text)["backups"]
    except (ValueError, KeyError, TypeError):
        sys.exit("relay: backups failed (bad response)")
    print("\n".join(str(d) for d in dates) if dates else "no backups")
    return 0


def cmd_request(a):
    status, text = call("POST", "/entry/v1/requests", {
        "name": a.name, "org": a.org, "project": a.project,
        "field": "notes" if a.notes else "password", "purpose": a.purpose, "replace": a.replace})
    if status != 201:
        print(one_line(text) if status in (400, 409, 429) else f"relay: request failed ({status})")
        return 1
    r = json.loads(text)
    print(f"request {r['id']} ({r['status']})")
    print(f"Enter it with: vault-entry {r['id']}   or   {BASE}/entry — your choice")
    return 0


def cmd_request_route(a):
    status, text = call("POST", "/entry/v1/route-requests", {
        "name": a.name, "org": a.org, "item": a.item, "upstream": a.upstream,
        "methods": a.method, "paths": a.path})
    if status != 201:
        errors = {400: "invalid route specification", 403: "device not authorized", 409: "route exists",
                  429: "too many requests", 503: "check broker approval service and enrollment"}
        sys.exit(f"relay: route request failed ({status}): {errors.get(status, 'broker unavailable')}")
    try:
        rid = json.loads(text)["id"]
        if not isinstance(rid, str) or not re.fullmatch("[0-9a-f]{40}", rid):
            raise ValueError
    except (ValueError, KeyError, TypeError):
        sys.exit("relay: invalid route request response")
    print(f"{BASE}/entry/approve/{rid}")


def cmd_status(a):
    status, text = call("GET", f"/entry/v1/requests/{urllib.parse.quote(a.id, safe='')}")
    if status != 200:
        sys.exit(f"relay: status failed ({status})")
    r = json.loads(text)
    print(r["status"])
    if r.get("result"):
        print(r["result"])
    return 0


def cmd_model(a):
    if not good_addr(BASE) or urllib.parse.urlsplit(BASE).path or "\\" in BASE:
        sys.exit("relay: model access needs the broker origin without a path")
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,62}", a.route):
        sys.exit("relay: invalid model route name")
    if not re.fullmatch(r"[a-zA-Z0-9~][a-zA-Z0-9._/:~+\[\]-]{0,199}", a.model):
        sys.exit("relay: invalid provider model ID")
    url = f"{BASE}/{a.org}/{a.route}"
    marker = "valetkey-broker-placeholder"
    env = os.environ.copy()
    for key in ("OPENAI_API_KEY", "CODEX_API_KEY", "OPENROUTER_API_KEY", "ANTHROPIC_API_KEY",
                "ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN"):
        env.pop(key, None)
    if a.client == "claude":
        for key in ("ANTHROPIC_CUSTOM_HEADERS", "CLAUDE_CODE_USE_BEDROCK",
                    "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_USE_FOUNDRY",
                    "CLAUDE_CODE_USE_ANTHROPIC_AWS"):
            env.pop(key, None)
        env.update(ANTHROPIC_BASE_URL=url, ANTHROPIC_API_KEY="", ANTHROPIC_AUTH_TOKEN=marker,
                   ANTHROPIC_MODEL=a.model, ANTHROPIC_DEFAULT_HAIKU_MODEL=a.model,
                   ANTHROPIC_DEFAULT_SONNET_MODEL=a.model, ANTHROPIC_DEFAULT_OPUS_MODEL=a.model,
                   CLAUDE_CODE_SUBAGENT_MODEL=a.model, CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1")
        argv = ["claude", "--model", a.model]
    else:
        env["VALETKEY_MODEL_PLACEHOLDER"] = marker
        # Process-scoped TOML overrides select the HTTP Responses transport.
        # This provider never requests the user's saved ChatGPT session.
        argv = ["codex", "-c", 'model_provider="valetkey"', "-c", "model=" + json.dumps(a.model),
                "-c", 'model_providers.valetkey.name="Valetkey"',
                "-c", "model_providers.valetkey.base_url=" + json.dumps(url + "/v1"),
                "-c", 'model_providers.valetkey.wire_api="responses"',
                "-c", 'model_providers.valetkey.env_key="VALETKEY_MODEL_PLACEHOLDER"',
                "-c", "model_providers.valetkey.requires_openai_auth=false",
                "-c", "model_providers.valetkey.supports_websockets=false"]
    try:
        os.execvpe(argv[0], argv + a.args, env)
    except OSError as exc:
        sys.exit(f"relay: could not start {a.client}: {exc.strerror}")


def add_client_commands(sub):
    model = sub.add_parser("model", help="launch a native CLI using an approved API-billed model route")
    model.add_argument("--org", choices=("local", "infra"), default="local")
    model.add_argument("client", choices=("claude", "codex"))
    model.add_argument("route", help="broker model route name")
    model.add_argument("model", help="model ID on the route's provider")
    model.add_argument("args", nargs=argparse.REMAINDER, help="arguments passed to the native CLI")
    model.set_defaults(fn=cmd_model)
    g = sub.add_parser("guide", help="print offline credential safety rules for agent memory")
    g.add_argument("topic", nargs="?", choices=GUIDE_TOPICS, help="show one section of the offline guide")
    g.set_defaults(fn=cmd_guide)
    u = sub.add_parser("set-url", help="save the broker URL, e.g. https://broker.<tailnet>.ts.net")
    u.add_argument("url")
    u.set_defaults(fn=cmd_set_url)
    c = sub.add_parser("check")
    c.add_argument("org")
    c.add_argument("names", nargs="+")
    c.set_defaults(fn=cmd_check)
    b = sub.add_parser("backups")
    b.add_argument("org")
    b.add_argument("name")
    b.set_defaults(fn=cmd_backups)
    r = sub.add_parser("request")
    r.add_argument("name")
    r.add_argument("--org", required=True, choices=["local", "infra"])
    r.add_argument("--project")
    r.add_argument("--purpose", required=True)
    r.add_argument("--notes", action="store_true")
    r.add_argument("--replace", action="store_true")
    r.set_defaults(fn=cmd_request)
    route = sub.add_parser("request-route", help="request owner approval for a new bearer API route")
    route.add_argument("name")
    route.add_argument("--org", choices=("local", "infra"), required=True)
    route.add_argument("--item", required=True)
    route.add_argument("--upstream", required=True)
    route.add_argument("--method", action="append", required=True)
    route.add_argument("--path", action="append", required=True)
    route.set_defaults(fn=cmd_request_route)
    s = sub.add_parser("status")
    s.add_argument("id")
    s.set_defaults(fn=cmd_status)


def main():
    global BASE
    p = argparse.ArgumentParser(prog="relay")
    p.add_argument("--version", action="version", version=CLIENT_VERSION)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("version", help="print the installed client version offline").set_defaults(fn=cmd_version)
    update = sub.add_parser("update", aliases=["latest-version"],
                            help="check for updates and print the latest stable public version")
    update.set_defaults(cmd="update", fn=cmd_latest_version)
    # Infrastructure installs point relay at the relay-version executable.
    if Path(__file__).resolve().name != "relay-version":
        add_client_commands(sub)
    a = p.parse_args()
    if a.cmd not in ("guide", "version", "update", "set-url"):
        BASE = _relay_url()
        if not BASE:
            sys.exit(f"relay: {NO_URL}")
    sys.exit(a.fn(a))


if __name__ == "__main__":
    main()
