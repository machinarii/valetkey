// valetkey: example tailnet policy. Merge the tagOwners, hosts, grants and tests into your own
// policy in the admin console (Access controls → JSON editor); back up the current one first.
// Replace the 100.x.y.z placeholders with each machine's address (`tailscale ip -4`).
//
// The shape: approver devices reach Vaultwarden and the broker; workload machines reach only the
// broker; the broker reaches Vaultwarden; nothing reaches the broker over SSH.
{
    "tagOwners": {
        "tag:vault":  ["autogroup:admin"],
        "tag:broker": ["autogroup:admin"],
        "tag:bellhop":   ["autogroup:admin"],   // optional: the bellhop
    },

    // Named machines. Names here are for the policy only; the broker identifies callers by their
    // Tailscale machine name (`tailscale whois`), which is what routes.toml `nodes` lists.
    "hosts": {
        "laptop": "100.x.y.z",   // approver device
        "phone":  "100.x.y.z",   // approver device (entry page only)
        "devbox": "100.x.y.z",   // workload machine: runs projects, agents
        "bot1":   "100.x.y.z",   // workload machine
    },

    "grants": [
        // No member-to-member or allow-all grant: agents must not reach approver devices or
        // trusted servers' administration ports. Grants are additive; remove broader grants
        // elsewhere in your policy. The tests below do not override an allowing grant.

        // Approver devices: Vaultwarden (web vault, Bitwarden apps) and the broker (entry page).
        {"src": ["laptop", "phone"], "dst": ["tag:vault", "tag:broker"], "ip": ["tcp:443"]},

        // Workload machines get credentials only through the broker, never from Vaultwarden.
        {"src": ["devbox", "bot1"], "dst": ["tag:broker"], "ip": ["tcp:443"]},

        // Workload machines use login-holding tools through the bellhop. Nothing else reaches it:
        // not approver devices, not the broker, and nobody over SSH.
        {"src": ["devbox", "bot1"], "dst": ["tag:bellhop"], "ip": ["tcp:443"]},

        // The broker reads from Vaultwarden.
        {"src": ["tag:broker"], "dst": ["tag:vault"], "ip": ["tcp:443"]},

        // No SSH to the broker over the tailnet: manage it from its console or LAN SSH.
    ],

    // Tested on every save; the save is rejected if one fails.
    "tests": [
        {"src": "laptop", "accept": ["tag:vault:443", "tag:broker:443"], "deny": ["tag:broker:22"]},
        {"src": "phone",  "accept": ["tag:vault:443", "tag:broker:443"], "deny": ["tag:broker:22"]},
        {"src": "devbox", "accept": ["tag:broker:443", "tag:bellhop:443"], "deny": ["tag:vault:443", "tag:broker:22", "tag:bellhop:22", "laptop:22", "phone:443"]},
        {"src": "bot1",   "accept": ["tag:broker:443"], "deny": ["tag:vault:443", "tag:broker:22", "laptop:22", "phone:443"]},
        {"src": "tag:broker", "accept": ["tag:vault:443"], "deny": ["tag:bellhop:443"]},
        {"src": "tag:bellhop", "deny": ["tag:vault:443", "tag:broker:443", "devbox:22"]},
    ],
}
