# valetkey vault settings, read by relay-login. Installed to /etc/relay/vault.env by
# `install.sh broker` (only if absent). Names and URLs only: never put a password here.
# Plain KEY=value lines, no quotes. A variable set in the environment wins over this file.

# Vaultwarden (or Bitwarden) server. Empty: https://vault.<your tailnet>.ts.net
VAULT_URL=

# Organization and top-level collection each relay account reads.
LOCAL_ORG=local-org
LOCAL_COLLECTION=local-broker-collection
INFRA_ORG=infra-org
INFRA_COLLECTION=infra-broker-collection
