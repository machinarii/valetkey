[Unit]
Description=Valetkey owner pairing and TOTP route approvals
After=tailscaled.service
ConditionPathExists=/etc/credstore.encrypted/relay-approval-key

[Service]
Group=relay-entry
ExecStart=/usr/bin/python3 -I /usr/local/libexec/relay/approval_worker.py
LoadCredentialEncrypted=relay-approval-key
RuntimeDirectory=relay-approval
RuntimeDirectoryMode=0750
StateDirectory=relay-approval
StateDirectoryMode=0700
ReadWritePaths=/etc/relay/approved-routes.d
InaccessiblePaths=-/etc/credstore.encrypted -/var/lib/relay-local -/var/lib/relay-infra -/var/lib/relay-entry -/var/lib/relay/tls
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
LimitCORE=0
UMask=0077
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
