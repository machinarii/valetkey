[Unit]
Description=Valetkey owner pairing and TOTP route approvals
After=tailscaled.service
ConditionPathExists=/etc/credstore.encrypted/valetkey-broker-approval-key

[Service]
Group=valetkey-broker-entry
ExecStart=/usr/bin/python3 -I /usr/local/libexec/valetkey-broker/approval_worker.py
LoadCredentialEncrypted=valetkey-broker-approval-key
RuntimeDirectory=valetkey-broker-approval
RuntimeDirectoryMode=0750
StateDirectory=valetkey-broker-approval
StateDirectoryMode=0700
ReadWritePaths=/etc/valetkey-broker/approved-routes.d
InaccessiblePaths=-/etc/credstore.encrypted -/var/lib/valetkey-broker-local -/var/lib/valetkey-broker-infra -/var/lib/valetkey-broker-entry -/var/lib/valetkey-broker-front/tls
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
LimitCORE=0
UMask=0077
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
