# Installed by valetkey (install.sh broker). TLS front door on the Tailscale IPv4 :443; no vault access.
# Certificate in /var/lib/valetkey-broker-front/tls (root:valetkey-broker-front 640), renewed by valetkey-broker-cert.timer.
[Unit]
Description=Credential broker, TLS front door
After=network-online.target tailscaled.service valetkey-broker-local.service valetkey-broker-infra.service valetkey-broker-entry.service
Wants=network-online.target

[Service]
User=valetkey-broker-front
Group=valetkey-broker-front
WorkingDirectory=/usr/local/libexec/valetkey-broker
ExecStart=/usr/bin/python3 -I /usr/local/libexec/valetkey-broker/broker_front.py \
  --backend local=127.0.0.1:8441 --backend infra=127.0.0.1:8442 --backend entry=127.0.0.1:8443 \
  --tls-dir /var/lib/valetkey-broker-front/tls
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
# The TLS private key is in this process: never in a core file on disk.
LimitCORE=0
UMask=0077
ProtectProc=invisible
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
