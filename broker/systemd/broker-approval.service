[Unit]
Description=Valetkey owner pairing and TOTP route approvals
After=tailscaled.service
ConditionPathExists=/etc/credstore.encrypted/broker-approval-key

[Service]
Group=broker-entry
ExecStart=/usr/bin/python3 -I /usr/local/libexec/broker/approval_worker.py
LoadCredentialEncrypted=broker-approval-key
RuntimeDirectory=broker-approval
RuntimeDirectoryMode=0750
StateDirectory=broker-approval
StateDirectoryMode=0700
ReadWritePaths=/etc/broker/approved-routes.d
InaccessiblePaths=-/etc/credstore.encrypted -/var/lib/broker-local -/var/lib/broker-infra -/var/lib/broker-entry -/var/lib/broker/tls
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
LimitCORE=0
UMask=0077
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
