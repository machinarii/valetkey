# Installed by valetkey (install.sh broker). TLS front door on the Tailscale IPv4 :443; no vault access.
# Certificate in /var/lib/relay/tls (root:relay-front 640), renewed by relay-cert.timer.
[Unit]
Description=Credential relay, TLS front door
After=network-online.target tailscaled.service relay-local.service relay-infra.service relay-entry.service
Wants=network-online.target

[Service]
User=relay-front
Group=relay-front
WorkingDirectory=/usr/local/libexec/relay
ExecStart=/usr/bin/python3 -I /usr/local/libexec/relay/relay_front.py \
  --backend local=127.0.0.1:8441 --backend infra=127.0.0.1:8442 --backend entry=127.0.0.1:8443 \
  --tls-dir /var/lib/relay/tls
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
# The TLS private key is in this process: never in a core file on disk.
LimitCORE=0
UMask=0077
ProtectProc=invisible
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
