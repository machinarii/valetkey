# Installed by valetkey (install.sh broker). Renews the front door's Tailscale certificate (root: tailscale
# cert needs it), then restarts broker-front if it is running.
[Unit]
Description=Renew the credential broker's Tailscale certificate
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/broker/broker-cert
