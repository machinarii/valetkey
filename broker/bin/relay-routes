#!/bin/bash
# Usage: sudo relay-routes check
#        sudo relay-routes install [local|infra]
# check    validates /etc/relay/routes.toml and /etc/relay/entry.toml (names, orgs, nodes, globs).
# install  check, then regenerate /var/lib/relay-<org>/api.toml (fnox references only) from the
#          routes and org.json, and restart relay-<org>. Without an org: both read relays.
#          With [api.*] routes it first asks relay-check whether fnox can find each route's item,
#          and changes nothing if not; after the restart it waits until the relay listens, and
#          puts the previous api.toml back if it never does.
# Edit /etc/relay/routes.toml, then run `sudo relay-routes install`. Prints names only.
# After editing entry.toml: sudo relay-routes check && sudo systemctl restart relay-entry
set -euo pipefail
[ "$(id -u)" = 0 ] || { echo "Run with sudo." >&2; exit 1; }
libexec=/usr/local/libexec/relay
routes=/etc/relay/routes.toml
entry=/etc/relay/entry.toml
usage="usage: relay-routes check | install [local|infra]"

check() {
  /usr/bin/python3 -I -c '
import sys
sys.path.insert(0, sys.argv[1])
from relaylib.routes import RoutesError, load_routes, load_entry_config
try:
    r = load_routes(sys.argv[2])
except (OSError, ValueError, RoutesError) as err:
    sys.exit(f"FAIL  {sys.argv[2]}: {err}")
for org in ("local", "infra"):
    o = r.for_org(org)
    print(f"ok    {sys.argv[2]} {org}: {len(o.api)} api, {len(o.values)} value, {len(o.projects)} project routes")
try:
    ec = load_entry_config(sys.argv[3])
    r.validate_owners(ec.owner_nodes)
except (OSError, ValueError, RoutesError) as err:
    sys.exit(f"FAIL  {sys.argv[3]}: {err}")
print(f"ok    {sys.argv[3]}: {len(ec.owner_nodes)} owner nodes")
print(f"policy: {len(r.agent_nodes)} broker-only agent nodes; {len(r.trusted_value_nodes)} trusted raw-value consumers")
for kind, entries in (("value", r.values), ("project", r.projects)):
    for name, route in entries.items():
        if any(not r.may_read_values(n) for n in route.nodes):
            print(f"warn  [{kind}.{name}]: raw reads denied for nodes outside security.trusted_value_nodes")
' "$libexec" "$routes" "$entry"
}

# With [api.*] routes a read relay starts under `fnox proxy run`, which resolves every proxy secret
# first and exits when one is missing or its name matches two items. The unit then restarts in a
# loop, `systemctl is-active` says "active" for most of each round, and every route of the org is
# down. So: the port, not the unit state, says whether the relay is up.
START_WAIT=${RELAY_START_WAIT:-90}

listening() {  # relay-<org> has bound its loopback port
  local port out
  case $1 in local) port=8441 ;; infra) port=8442 ;; *) return 1 ;; esac
  # Not `ss | grep -q`: under pipefail, grep leaving early can kill ss and read as "not listening".
  out=$(ss -ltn 2>/dev/null) || true
  grep -q ":$port " <<< "$out"
}

wait_listening() {  # true once relay-<org> listens and still does 3 s later
  local org=$1 i
  for ((i = 0; i < START_WAIT; i += 3)); do
    if listening "$org"; then sleep 3; listening "$org" && return 0; fi
    sleep 3
  done
  return 1
}

api_item_problems() {  # relay-check's FAIL lines about [api.*] items of <org>; names only
  "$(dirname "$0")/relay-check" "$1" 2>/dev/null | grep '^FAIL  \[api\.' || true
}

install_org() {
  local org=$1 user=relay-$1 home=/var/lib/relay-$1 org_id tmp n bad
  if [ ! -f "$home/org.json" ]; then
    echo "skip  relay-$org: no org.json yet; run relay-login $org <email> first"
    return 0
  fi
  org_id=$(jq -er '.org_id' "$home/org.json") || { echo "FAIL  $home/org.json has no org_id" >&2; return 1; }
  tmp=$home/api.toml.tmp
  if ! /usr/bin/python3 -I "$libexec/gen-fnox-config.py" --routes "$routes" --org "$org" \
        --org-id "$org_id" > "$tmp"; then
    rm -f "$tmp"; echo "FAIL  api.toml for $org not generated" >&2; return 1
  fi
  n=$(grep -c '^\[\[proxy.rules\]\]' "$tmp" || true)
  if [ "$n" != 0 ] && [ -f "/etc/credstore.encrypted/bw-unlock-$org" ]; then
    bad=$(api_item_problems "$org")
    if [ -n "$bad" ]; then
      rm -f "$tmp"
      printf '%s\n' "$bad" >&2
      echo "FAIL  relay-$org not changed: fix the items above, then run relay-routes install again" >&2
      return 1
    fi
  fi
  chown "$user:$user" "$tmp"
  chmod 600 "$tmp"
  if [ -f "$home/api.toml" ]; then cp -p "$home/api.toml" "$home/api.toml.prev"; fi
  mv -f "$tmp" "$home/api.toml"
  echo "ok    $home/api.toml: $n api routes"
  if [ ! -f "/etc/credstore.encrypted/bw-unlock-$org" ]; then
    echo "skip  relay-$org: run relay-login $org <email> first"
    return 0
  fi
  systemctl enable "relay-$org.service" >/dev/null 2>&1 || true
  systemctl restart "relay-$org.service"
  if wait_listening "$org"; then
    echo "ok    relay-$org running"
    return 0
  fi
  echo "FAIL  relay-$org did not start; see: journalctl -u relay-$org -n 30" >&2
  if [ -f "$home/api.toml.prev" ]; then
    cp -p "$home/api.toml.prev" "$home/api.toml"
    systemctl restart "relay-$org.service"
    if wait_listening "$org"; then
      echo "FAIL  relay-$org runs again with its previous api.toml; the new [api.*] routes are not active" >&2
    else
      echo "FAIL  relay-$org is still down with its previous api.toml" >&2
    fi
  fi
  return 1
}

case ${1:-} in
  check)
    check ;;
  install)
    case ${2:-all} in local|infra|all) ;; *) echo "$usage" >&2; exit 2 ;; esac
    check
    rc=0
    for org in local infra; do
      if [ "${2:-all}" = all ] || [ "$2" = "$org" ]; then install_org "$org" || rc=1; fi
    done
    exit $rc ;;
  *)
    echo "$usage" >&2; exit 2 ;;
esac
