#!/usr/bin/python3 -I
"""Create an expiring owner-device authenticator pairing link at the trusted broker console."""
import argparse
import os
from pathlib import Path
import secrets
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, "/usr/local/libexec/broker")
from brokerlib.approval_rpc import request
from brokerlib.routes import load_entry_config, load_routes


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=["pair"])
    parser.add_argument("owner", help="Tailscale name of a configured approver device")
    args = parser.parse_args()
    if os.getuid() != 0:
        sys.exit("Run from the broker console with sudo.")
    conf = load_entry_config("/etc/broker/entry.toml")
    load_routes("/etc/broker/routes.toml").validate_owners(conf.owner_nodes)
    if args.owner not in conf.owner_nodes:
        sys.exit("Device must already be in entry.toml owner_nodes.")
    if not Path("/usr/bin/qrencode").is_file():
        sys.exit("Install the Debian/Ubuntu qrencode package on the broker first.")
    key = Path("/etc/credstore.encrypted/broker-approval-key")
    if not key.exists():
        with tempfile.TemporaryDirectory(dir=key.parent) as tmp:
            out = Path(tmp) / "key"
            subprocess.run(["/usr/bin/systemd-creds", "encrypt", "--name=broker-approval-key", "-", out],
                           input=secrets.token_bytes(32), check=True)
            out.chmod(0o600)
            try:
                os.link(out, key)
            except FileExistsError:
                pass
    subprocess.run(["/usr/bin/systemctl", "enable", "--now", "broker-approval.service"], check=True)
    for attempt in range(20):
        try:
            status, value = request({"op": "open-pair", "owner": args.owner})
            break
        except (FileNotFoundError, ConnectionRefusedError):
            time.sleep(0.25)
    else:
        sys.exit("Approval worker did not start. Check broker-approval.service.")
    if status != 200:
        sys.exit(value)
    print(f"Open on {args.owner} within 10 minutes: https://{conf.tailnet_name}/entry/pair/{value}")


if __name__ == "__main__":
    main()
