#!/bin/bash
# Usage: sudo valetkey-broker routes check
#        sudo valetkey-broker routes install [local|infra]
# check    validates /etc/valetkey-broker/routes.toml and /etc/valetkey-broker/entry.toml (names, orgs, nodes, globs).
# install  check, then regenerate /var/lib/valetkey-broker-<org>/api.toml (fnox references only) from the
#          routes and org.json, and restart valetkey-broker-<org>. Without an org: both read services.
#          With [api.*] routes it first asks valetkey-broker check whether fnox can find each route's item,
#          and changes nothing if not; after the restart it waits until the broker listens, and
#          puts the previous api.toml back if it never does.
# Edit /etc/valetkey-broker/routes.toml, then run `sudo valetkey-broker routes install`. Prints names only.
# After editing entry.toml: sudo valetkey-broker routes check && sudo systemctl restart valetkey-broker-entry
set -euo pipefail
[ "$(id -u)" = 0 ] || { echo "Run with sudo." >&2; exit 1; }
libexec=/usr/local/libexec/valetkey-broker
routes=/etc/valetkey-broker/routes.toml
entry=/etc/valetkey-broker/entry.toml
usage="usage: valetkey-broker routes check | install [local|infra]"

check() {
  /usr/bin/python3 -I -c '
import sys
sys.path.insert(0, sys.argv[1])
from brokerlib.routes import RoutesError, load_routes, load_entry_config
try:
    r = load_routes(sys.argv[2])
except (OSError, ValueError, RoutesError) as err:
    sys.exit(f"FAIL  {sys.argv[2]}: {err}")
for org in ("local", "infra"):
    o = r.for_org(org)
    print(f"ok    {sys.argv[2]} {org}: {len(o.api)} api, {len(o.values)} value, {len(o.projects)} project routes")
try:
    ec = load_entry_config(sys.argv[3])
    r.validate_owners(ec.owner_nodes)
except (OSError, ValueError, RoutesError) as err:
    sys.exit(f"FAIL  {sys.argv[3]}: {err}")
print(f"ok    {sys.argv[3]}: {len(ec.owner_nodes)} owner nodes")
print(f"policy: {len(r.agent_nodes)} agent nodes; {len(r.trusted_value_nodes)} trusted raw-value consumers")
for kind, entries in (("value", r.values), ("project", r.projects)):
    for name, route in entries.items():
        if kind == "value" and route.claude_setup_token:
            print(f"grant [{kind}.{name}]: any process on {route.nodes[0]} may read its Claude setup token")
        elif any(not r.may_read_values(n) for n in route.nodes):
            print(f"warn  [{kind}.{name}]: raw reads denied for nodes outside security.trusted_value_nodes")
' "$libexec" "$routes" "$entry"
}

# With [api.*] routes a read service starts under `fnox proxy run`, which resolves every proxy secret
# first and exits when one is missing or its name matches two items. The unit then restarts in a
# loop, `systemctl is-active` says "active" for most of each round, and every route of the org is
# down. So: the port, not the unit state, says whether the broker is up.
START_WAIT=${BROKER_START_WAIT:-90}

listening() {  # valetkey-broker-<org> has bound its loopback port
  local port out
  case $1 in local) port=8441 ;; infra) port=8442 ;; *) return 1 ;; esac
  # Not `ss | grep -q`: under pipefail, grep leaving early can kill ss and read as "not listening".
  out=$(ss -ltn 2>/dev/null) || true
  grep -q ":$port " <<< "$out"
}

wait_listening() {  # true once valetkey-broker-<org> listens and still does 3 s later
  local org=$1 i
  for ((i = 0; i < START_WAIT; i += 3)); do
    if listening "$org"; then sleep 3; listening "$org" && return 0; fi
    sleep 3
  done
  return 1
}

api_item_problems() {  # valetkey-broker check's FAIL lines about [api.*] items of <org>; names only
  "$(dirname "$0")/valetkey-broker-check" "$1" 2>/dev/null | grep '^FAIL  \[api\.' || true
}

install_org() {
  local org=$1 user=valetkey-broker-$1 home=/var/lib/valetkey-broker-$1 org_id tmp n bad
  if [ ! -f "$home/org.json" ]; then
    [ "${verified:-no}" = yes ] && return 1
    echo "skip  valetkey-broker-$org: no org.json yet; run valetkey-broker login $org <email> first"
    return 0
  fi
  org_id=$(runuser -u "$user" -- jq -er '.org_id' "$home/org.json") || { echo "FAIL  $home/org.json has no org_id" >&2; return 1; }
  tmp=$(mktemp /run/broker-fnox.XXXXXXXX) || return 1
  if ! /usr/bin/python3 -I "$libexec/gen-fnox-config.py" --routes "$routes" --org "$org" \
        --org-id "$org_id" > "$tmp"; then
    rm -f "$tmp"; echo "FAIL  api.toml for $org not generated" >&2; return 1
  fi
  n=$(grep -c '^\[\[proxy.rules\]\]' "$tmp" || true)
  if [ "${verified:-no}" != yes ] && [ "$n" != 0 ] && [ -f "/etc/credstore.encrypted/bw-unlock-$org" ]; then
    bad=$(api_item_problems "$org")
    if [ -n "$bad" ]; then
      rm -f "$tmp"
      printf '%s\n' "$bad" >&2
      echo "FAIL  valetkey-broker-$org not changed: fix the items above, then run valetkey-broker routes install again" >&2
      return 1
    fi
  fi
  # All writes in this service-owned directory run with the service's own privileges.
  if ! runuser -u "$user" -- /bin/bash -ec '
    cd "$1"
    umask 077
    tmp=$(mktemp .api.XXXXXXXX)
    trap '\''rm -f -- "$tmp"'\'' EXIT
    cat > "$tmp"
    if [ -f api.toml ]; then cp -p --remove-destination api.toml api.toml.prev; fi
    mv -fT -- "$tmp" api.toml
  ' bash "$home" < "$tmp"; then rm -f "$tmp"; return 1; fi
  rm -f "$tmp"
  echo "ok    $home/api.toml: $n api routes"
  if [ ! -f "/etc/credstore.encrypted/bw-unlock-$org" ]; then
    [ "${verified:-no}" = yes ] && return 1
    echo "skip  valetkey-broker-$org: run valetkey-broker login $org <email> first"
    return 0
  fi
  systemctl enable "valetkey-broker-$org.service" >/dev/null 2>&1 || true
  if systemctl restart "valetkey-broker-$org.service" && wait_listening "$org"; then
    echo "ok    valetkey-broker-$org running"
    return 0
  fi
  echo "FAIL  valetkey-broker-$org did not start; see: journalctl -u valetkey-broker-$org -n 30" >&2
  if [ -f "$home/api.toml.prev" ]; then
    runuser -u "$user" -- cp -p --remove-destination "$home/api.toml.prev" "$home/api.toml" || return 1
    if systemctl restart "valetkey-broker-$org.service" && wait_listening "$org"; then
      echo "FAIL  valetkey-broker-$org runs again with its previous api.toml; the new [api.*] routes are not active" >&2
    else
      echo "FAIL  valetkey-broker-$org is still down with its previous api.toml" >&2
    fi
  fi
  return 1
}

case ${1:-} in
  check)
    check ;;
  install|install-verified)
    exec 9>/run/valetkey-install.lock
    flock -x 9
    verified=no
    if [ "$1" = install-verified ]; then
      verified=yes
      case ${2:-} in local|infra) ;; *) exit 2 ;; esac
      [ -f "/var/lib/valetkey-broker-$2/org.json" ] && [ -f "/etc/credstore.encrypted/bw-unlock-$2" ] || exit 1
      "$(dirname "$0")/valetkey-broker-check" "$2" --api-only >/dev/null || exit 1
    fi
    case ${2:-all} in local|infra|all) ;; *) echo "$usage" >&2; exit 2 ;; esac
    check
    rc=0
    for org in local infra; do
      if [ "${2:-all}" = all ] || [ "$2" = "$org" ]; then install_org "$org" || rc=1; fi
    done
    exit $rc ;;
  *)
    echo "$usage" >&2; exit 2 ;;
esac
