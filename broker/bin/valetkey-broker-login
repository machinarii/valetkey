#!/bin/bash
# Usage: sudo valetkey-broker login <local|infra|entry> <account-email>
# Interactive only (a secure terminal on the broker or its hypervisor console). For one broker user:
# the master password is read with hidden input, passed to bw in an environment variable (never
# an argument), and stored encrypted as /etc/credstore.encrypted/bw-unlock-<name>. While still
# unlocked it writes /var/lib/valetkey-broker-<name>/org.json (org and collection ids, mode 600), then locks.
# Prints names and counts only. Settings come from the environment or /etc/valetkey-broker/vault.env:
# VAULT_URL (default https://vault.<tailnet suffix>) and LOCAL_ORG, INFRA_ORG, LOCAL_COLLECTION,
# INFRA_COLLECTION (see vault-info.py).
set -euo pipefail
usage="usage: valetkey-broker login <local|infra|entry> <account-email>"
[ "$(id -u)" = 0 ] || { echo "Run with sudo." >&2; exit 1; }
[ -t 0 ] || { echo "Run from an interactive terminal." >&2; exit 1; }
name=${1:?$usage}
email=${2:?$usage}
case $name in local|infra|entry) ;; *) echo "$usage" >&2; exit 2 ;; esac

user=valetkey-broker-$name
home=/var/lib/valetkey-broker-$name
appdata=$home/bw-cli
libexec=/usr/local/libexec/valetkey-broker
cred=/etc/credstore.encrypted/bw-unlock-$name
id "$user" >/dev/null 2>&1 || { echo "No user $user: run install.sh broker first." >&2; exit 1; }

# /etc/valetkey-broker/vault.env: plain KEY=value lines (names and URLs only). Only these keys are read,
# the file is never sourced, and a variable already set in the environment wins.
conf=/etc/valetkey-broker/vault.env
if [ -f "$conf" ]; then
  while IFS='=' read -r key val; do
    case $key in
      VAULT_URL|LOCAL_ORG|INFRA_ORG|LOCAL_COLLECTION|INFRA_COLLECTION)
        if [ -z "${!key:-}" ] && [ -n "$val" ]; then export "$key=$val"; fi ;;
    esac
  done < <(grep -E '^[A-Z_]+=' "$conf")
fi
if [ -z "${VAULT_URL:-}" ]; then
  suffix=$(tailscale status --json | jq -r '.MagicDNSSuffix // empty')
  [ -n "$suffix" ] || { echo "Cannot find the tailnet name; set VAULT_URL." >&2; exit 1; }
  VAULT_URL=https://vault.$suffix
fi
cd /

# Stop the unit first: its own `bw unlock` as the same user (a restart, or a restart loop on an
# old credential) would replace this login's session mid-way. It is started again at the end,
# after api.toml (read services, via valetkey-broker routes install) and org.json exist.
systemctl stop "valetkey-broker-$name.service" 2>/dev/null || true

# bw as the broker user, with its own data dir. runuser keeps the exported BW_* variables.
bwu() { runuser -u "$user" -- env HOME="$home" BITWARDENCLI_APPDATA_DIR="$appdata" bw "$@"; }
relock() { bwu lock >/dev/null 2>&1 || true; }

read -rsp "Master password for $email ($user): " BW_PASSWORD; echo
[ -n "$BW_PASSWORD" ] || { echo "Empty password." >&2; exit 1; }
export BW_PASSWORD
bwu logout >/dev/null 2>&1 || true
bwu config server "$VAULT_URL" >/dev/null
trap relock EXIT
BW_SESSION=$(bwu login "$email" --passwordenv BW_PASSWORD --raw)
export BW_SESSION
printf '%s' "$BW_PASSWORD" | systemd-creds encrypt --name="bw-unlock-$name" - "$cred"
unset BW_PASSWORD
chmod 600 "$cred"
echo "ok    $user logged in to $VAULT_URL; unlock credential stored"

bwu sync >/dev/null
tmp=$home/org.json.tmp
umask 077
if ! runuser -u "$user" -- env HOME="$home" BITWARDENCLI_APPDATA_DIR="$appdata" \
      /usr/bin/python3 -I "$libexec/vault-info.py" org-json "$name" > "$tmp"; then
  rm -f "$tmp"
  echo "FAIL  org.json not written; fix the access above, then re-run valetkey-broker login $name <email>" >&2
  exit 1
fi
chown "$user:$user" "$tmp"
chmod 600 "$tmp"
mv -f "$tmp" "$home/org.json"
relock
trap - EXIT
unset BW_SESSION
echo "ok    $home/org.json written; vault locked"

# (Re)start the service with the new login.
if [ -f "/etc/systemd/system/valetkey-broker-$name.service" ]; then
  if [ "$name" = entry ]; then
    systemctl enable valetkey-broker-entry.service >/dev/null 2>&1 || true
    systemctl restart valetkey-broker-entry.service
    sleep 3
    if systemctl is-active --quiet valetkey-broker-entry.service; then echo "ok    valetkey-broker-entry running"
    else echo "FAIL  valetkey-broker-entry not running; see: journalctl -u valetkey-broker-entry -n 30" >&2; exit 1; fi
  else
    "$(dirname "$0")/valetkey-broker-routes" install "$name"
  fi
fi
echo "Next: sudo valetkey-broker check $name"
