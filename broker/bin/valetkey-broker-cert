#!/bin/bash
# Run by valetkey-broker-cert.service (root), weekly and from install.sh broker: fetches the Tailscale HTTPS
# certificate for this machine into /var/lib/valetkey-broker-front/tls (group valetkey-broker-front, mode 640) and restarts
# valetkey-broker-front if it is running. Needs HTTPS Certificates enabled in the tailnet.
set -euo pipefail
umask 027
tls=/var/lib/valetkey-broker-front/tls
dns=$(tailscale status --json | jq -r '.Self.DNSName' | sed 's/\.$//')
[ -n "$dns" ] && [ "$dns" != null ] || { echo "valetkey-broker-cert: no tailnet DNS name" >&2; exit 1; }
install -d -o root -g valetkey-broker-front -m 750 "$tls"
tailscale cert --cert-file "$tls/cert.pem.new" --key-file "$tls/key.pem.new" "$dns" >/dev/null
chgrp valetkey-broker-front "$tls/cert.pem.new" "$tls/key.pem.new"
chmod 640 "$tls/cert.pem.new" "$tls/key.pem.new"
mv -f "$tls/cert.pem.new" "$tls/cert.pem"
mv -f "$tls/key.pem.new" "$tls/key.pem"
systemctl try-restart valetkey-broker-front.service
echo "valetkey-broker-cert: certificate for $dns"
