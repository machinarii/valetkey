#!/bin/bash
# Linux-only, isolated tests. No host home, external network, credentials or live services.
# All fixture writes live in a bounded, disposable tmpfs. Optional unittest names follow.
set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
for tool in bwrap prlimit timeout python3; do
  command -v "$tool" >/dev/null || { echo "Missing sandbox tool: $tool" >&2; exit 1; }
done
if [ "${1:-}" = --lint ]; then
  shift
  command=(make lint)
else
  if [ $# -eq 0 ]; then set -- discover -s broker/tests -t .; fi
  command=(/usr/bin/python3 -m unittest "$@")
fi
exec env -i PATH=/usr/bin:/bin /usr/bin/timeout 240 /usr/bin/bwrap \
  --unshare-all --die-with-parent --new-session --cap-drop ALL \
  --ro-bind /usr /usr --symlink usr/bin /bin --symlink usr/lib /lib \
  --symlink usr/lib64 /lib64 --proc /proc --dev /dev \
  --ro-bind "$repo" /src --ro-bind-data 3 /etc/hosts \
  --size 268435456 --tmpfs /scratch --symlink /scratch /tmp --dir /scratch/home \
  --clearenv --setenv PATH /usr/bin:/bin --setenv HOME /scratch/home \
  --setenv TMPDIR /scratch --setenv PYTHONDONTWRITEBYTECODE 1 --setenv LC_ALL C.UTF-8 \
  --setenv PYTHONPYCACHEPREFIX /scratch/pycache \
  --chdir /src /usr/bin/prlimit --cpu=180 --as=2147483648 --nproc=2048 \
  --nofile=512 --fsize=16777216 --core=0 "${command[@]}" \
  3<<<'127.0.0.1 localhost'
